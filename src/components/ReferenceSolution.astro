---
interface Props {
  title?: string;
  badge?: string;
}

const { title = "Reference Implementation", badge = "Reveal" } = Astro.props;
---

<details class="solution-box">
  <summary class="solution-head">
    <span class="left">
      <span class="lock-icon" aria-hidden="true">▣</span>
      <span class="title">{title}</span>
    </span>
    <span class="reveal-btn">{badge}</span>
  </summary>
  <div class="solution-body">
    <slot />
  </div>
</details>

<style>
  .solution-box {
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 9px;
    overflow: hidden;
    margin: 1.5rem 0;
    background: var(--sl-color-gray-6);
  }

  .solution-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--sl-color-gray-6);
    cursor: pointer;
    user-select: none;
    font-size: 13.5px;
    font-weight: 500;
    list-style: none;
    transition: background 0.15s ease;
  }

  .solution-head::-webkit-details-marker {
    display: none;
  }

  .solution-head:hover {
    background: var(--sl-color-gray-5);
  }

  .solution-head .left {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--sl-color-white);
  }

  .lock-icon {
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  .solution-head .reveal-btn {
    font-size: 11.5px;
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 5px;
    padding: 3px 9px;
    font-weight: 400;
  }

  .solution-body {
    padding: 16px;
    border-top: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-black);
  }
</style>
