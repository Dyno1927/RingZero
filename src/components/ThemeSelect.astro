---
---

<theme-toggle>
  <button
    type="button"
    class="theme-toggle-btn"
    aria-label="Toggle theme"
    title="Toggle dark / light theme"
  >
    <span class="theme-icon-wrapper" aria-hidden="true">
      <svg
        class="sun-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <svg
        class="moon-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </span>
    <span class="theme-label">dark</span>
  </button>
</theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector("button");
      if (!button) return;

      const updateUI = () => {
        const isDark = document.documentElement.dataset.theme === "dark";
        const label = this.querySelector(".theme-label");
        if (label) {
          label.textContent = isDark ? "dark" : "light";
        }
        button.setAttribute(
          "aria-label",
          `Switch to ${isDark ? "light" : "dark"} mode`
        );
      };

      updateUI();

      button.addEventListener("click", () => {
        const currentTheme = document.documentElement.dataset.theme || "dark";
        const nextTheme = currentTheme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        if (typeof localStorage !== "undefined") {
          localStorage.setItem("starlight-theme", nextTheme);
        }

        document.querySelectorAll("theme-toggle").forEach((el) => {
          const l = el.querySelector(".theme-label");
          if (l) l.textContent = nextTheme;
          const b = el.querySelector("button");
          if (b)
            b.setAttribute(
              "aria-label",
              `Switch to ${nextTheme === "dark" ? "light" : "dark"} mode`
            );
        });
      });

      const observer = new MutationObserver(() => updateUI());
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }
  }

  if (!customElements.get("theme-toggle")) {
    customElements.define("theme-toggle", ThemeToggle);
  }
</script>

<style>
  theme-toggle {
    display: inline-flex;
    align-items: center;
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 7px;
    padding: 0.35rem 0.65rem;
    font-size: var(--sl-text-xs);
    font-family: var(--sl-font-mono);
    line-height: 1;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
    user-select: none;
  }

  .theme-toggle-btn:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-gray-5);
  }

  .theme-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  :global(:root[data-theme="dark"]) .sun-icon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon-icon {
    display: block;
    color: var(--sl-color-accent);
  }

  :global(:root[data-theme="light"]) .moon-icon {
    display: none;
  }
  :global(:root[data-theme="light"]) .sun-icon {
    display: block;
    color: var(--sl-color-accent);
  }

  .theme-label {
    text-transform: lowercase;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
</style>
