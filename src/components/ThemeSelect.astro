---
---

<theme-toggle>
  <button
    type="button"
    class="theme-toggle-btn"
    aria-label="Change color theme"
    title="Change color theme"
  >
    <span class="theme-icon-wrapper" aria-hidden="true">
      <svg
        class="sun-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <svg
        class="moon-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </span>
    <span class="theme-label">system</span>
  </button>
</theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector("button");
      if (!button) return;

      const readPreference = (key) => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };
      const savePreference = (key, value) => {
        try {
          localStorage.setItem(key, value);
        } catch {
          // The active page theme still works when persistent storage is unavailable.
        }
      };
      const getPreference = () => {
        const saved = readPreference("ring0-theme");
        if (saved === "dark" || saved === "light" || saved === "system") return saved;
        const legacy = readPreference("starlight-theme");
        if (legacy === "dark" || legacy === "light") return legacy;
        const activePreference = document.documentElement.dataset.themePreference;
        return activePreference === "dark" || activePreference === "light"
          ? activePreference
          : "system";
      };
      const getSystemTheme = () =>
        window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      const applyTheme = (preference) => {
        const resolvedTheme = preference === "system" ? getSystemTheme() : preference;
        document.documentElement.dataset.theme = resolvedTheme;
        document.documentElement.dataset.themePreference = preference;
      };
      const updateUI = () => {
        const preference = getPreference();
        const label = this.querySelector(".theme-label");
        if (label) label.textContent = preference;
        button.setAttribute("aria-label", `Color theme: ${preference}. Activate to change.`);
        button.title = `Color theme: ${preference}`;
        document.querySelectorAll("theme-toggle .theme-label").forEach((item) => {
          item.textContent = preference;
        });
        document.querySelectorAll("theme-toggle button").forEach((item) => {
          item.setAttribute("aria-label", `Color theme: ${preference}. Activate to change.`);
          item.title = `Color theme: ${preference}`;
        });
      };

      const preference = getPreference();
      applyTheme(preference);
      updateUI();

      button.addEventListener("click", () => {
        const current = getPreference();
        const next = current === "system" ? "dark" : current === "dark" ? "light" : "system";
        savePreference("ring0-theme", next);
        savePreference("starlight-theme", next === "system" ? "" : next);
        applyTheme(next);
        updateUI();
      });

      const systemPreference = window.matchMedia("(prefers-color-scheme: dark)");
      systemPreference.addEventListener?.("change", () => {
        if (getPreference() === "system") {
          applyTheme("system");
          updateUI();
        }
      });

      /* Starlight can update the theme during client navigation. Keep the label honest. */
      const observer = new MutationObserver(updateUI);
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }
  }

  if (!customElements.get("theme-toggle")) {
    customElements.define("theme-toggle", ThemeToggle);
  }
</script>

<style>
  theme-toggle {
    display: inline-flex;
    align-items: center;
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 7px;
    padding: 0.35rem 0.65rem;
    font-size: var(--sl-text-xs);
    font-family: var(--sl-font-mono);
    line-height: 1;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
    user-select: none;
  }

  .theme-toggle-btn:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-gray-5);
  }

  .theme-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  :global(:root[data-theme="dark"]) .sun-icon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon-icon {
    display: block;
    color: var(--sl-color-accent);
  }

  :global(:root[data-theme="light"]) .moon-icon {
    display: none;
  }
  :global(:root[data-theme="light"]) .sun-icon {
    display: block;
    color: var(--sl-color-accent);
  }

  .theme-label {
    text-transform: lowercase;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
</style>
