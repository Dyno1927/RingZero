---
const pageTitle = "Page not found | Ring 0";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="This Ring 0 page does not exist. Continue with an available systems programming guide."
    />
    <meta name="theme-color" content="#111416" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        color-scheme: dark light;
        font-family: system-ui, sans-serif;
        background: #111416;
        color: #e7ebe8;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      * { box-sizing: border-box; }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        grid-template-rows: auto 1fr auto;
        background: #111416;
      }

      a { color: inherit; }

      .topbar, footer {
        padding: 1rem clamp(1.25rem, 5vw, 4rem);
        border-bottom: 1px solid #2c3438;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
      }

      .mark {
        display: grid;
        width: 2rem;
        aspect-ratio: 1;
        place-items: center;
        border-radius: 0.4rem;
        background: #123027;
        color: #83d8bb;
        font-family: ui-monospace, monospace;
      }

      main {
        width: min(100% - 2.5rem, 48rem);
        margin: auto;
        padding-block: 5rem;
      }

      .eyebrow {
        color: #83d8bb;
        font: 500 0.8rem ui-monospace, monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0.75rem 0;
        font-size: clamp(2.2rem, 7vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.08;
      }

      main > p { max-width: 58ch; color: #9ba7a3; line-height: 1.7; }

      nav {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
        gap: 0.75rem;
        margin-top: 2rem;
      }

      nav a {
        padding: 0.9rem 1rem;
        border: 1px solid #2c3438;
        border-radius: 0.55rem;
        background: #181c1f;
        text-decoration: none;
      }

      nav a:hover { border-color: #55b89a; }
      a:focus-visible { outline: 2px solid #83d8bb; outline-offset: 3px; }
      footer { border-top: 1px solid #2c3438; border-bottom: 0; color: #9ba7a3; font-size: 0.85rem; }

      @media (prefers-color-scheme: light) {
        :root { background: #f5f4ef; color: #1b211f; }
        body { background: #f5f4ef; }
        .topbar, footer { border-color: #d9d7cf; }
        .mark { background: #dceee7; color: #145b48; }
        .eyebrow { color: #145b48; }
        main > p, footer { color: #626b66; }
        nav a { border-color: #d9d7cf; background: #fffefa; }
        nav a:hover { border-color: #247b63; }
        a:focus-visible { outline-color: #247b63; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Ring 0 home">
        <span class="mark" aria-hidden="true">R0</span>
        <span>Ring 0</span>
      </a>
    </header>
    <main>
      <p class="eyebrow">404 / page not found</p>
      <h1>That address has no page.</h1>
      <p>
        The page may have moved or may not be published yet. The roadmap marks
        planned topics clearly.
      </p>
      <nav aria-label="Available documentation">
        <a href="/roadmaps/learning-c/">Start learning C</a>
        <a href="/c/fundamentals/variables-and-types/">Explore C fundamentals</a>
        <a href="/cpp/fundamentals/c-to-cpp/">Explore modern C++</a>
        <a href="/planned/">Browse available and planned topics</a>
      </nav>
    </main>
    <footer>Systems programming, explained from the metal up.</footer>
  </body>
</html>
